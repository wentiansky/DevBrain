{
  "name": "devbrain",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm run dev:prepare && concurrently -k -n db,api,worker,web -c blue,green,magenta,cyan \"pnpm --filter @devbrain/db dev\" \"pnpm --filter @devbrain/api dev\" \"pnpm --filter @devbrain/worker dev\" \"pnpm run dev:web\"",
    "dev:infra": "docker compose up -d postgres redis",
    "dev:prepare": "pnpm --filter @devbrain/db build",
    "dev:web": "wait-on http-get://localhost:3001/readyz --timeout 30000 && pnpm --filter @devbrain/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check:migrations": "node scripts/check-migrations.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,yaml,yml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,yaml,yml}\" --ignore-path .gitignore",
    "gen:openapi": "pnpm --filter @devbrain/api gen:openapi",
    "gen:client": "pnpm --filter @devbrain/api gen:client",
    "release:vps": "bash scripts/release-vps.sh",
    "test:e2e": "pnpm --filter @devbrain/web test:e2e"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "@nestjs/core",
      "esbuild",
      "msgpackr-extract"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "concurrently": "^10.0.3",
    "prettier": "^3.5.0",
    "typescript": "^5.7.0",
    "wait-on": "^9.0.10"
  }
}
