<your-domain>, www.<your-domain> {
	encode zstd gzip

	handle /auth/* {
		reverse_proxy api:3001
	}

	handle /storage/local/* {
		reverse_proxy api:3001
	}

	handle_path /api/* {
		reverse_proxy api:3001 {
			flush_interval -1
			transport http {
				read_timeout 5m
			}
		}
	}

	handle {
		@nextstatic path /_next/static/* /_next/image*
		header @nextstatic Cache-Control "public, max-age=31536000, immutable"

		@publicassets path /favicon.ico /favicon.svg /icon.png /apple-icon.png /robots.txt
		header @publicassets Cache-Control "public, max-age=31536000, immutable"

		@html {
			not path /_next/static/* /_next/image* /favicon.ico /favicon.svg /icon.png /apple-icon.png /robots.txt
		}
		header @html Cache-Control "private, no-cache"

		reverse_proxy web:3000
	}
}